<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <h1>All Trainers</h1>
        <% for(let trainer of trainers) { %>
            <div>
                <p>Name : <%=trainer.tname%></p>
                <p>email : <%=trainer.email%></p>
                <p>age : <%=trainer.age%></p>
                <button><a href="/flexora/trainer/<%=trainer._id%>">see full details</a></button>
            </div>
        <% } %>
        <button><a href="/flexora/trainer/new">add Trainer</a></button>
    </div>
</body>
</html>