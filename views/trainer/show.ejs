<% layout("./layouts/boilerplate.ejs") %>

    <!-- ================= TRAINER DETAILS PAGE ================= -->

    <section class="flexora-trainer-details-page">

        <div class="container-fluid px-3 px-lg-5">

            <!-- Page Header -->
            <div class="flexora-page-header">

                <div>

                    <div class="flexora-breadcrumb">
                        <a href="/flexora">Home</a>
                        <span>/</span>
                        <a href="/flexora/trainer">Trainers</a>
                        <span>/</span>
                        <span>Trainer Details</span>
                    </div>

                    <h1>Trainer Details</h1>

                    <p>
                        View trainer information and manage trainer details.
                    </p>

                </div>

                <a href="/flexora/trainer" class="flexora-back-btn">
                    <i class="bi bi-arrow-left"></i>
                    Back to Trainers
                </a>

            </div>


            <!-- Trainer Profile Card -->
            <div class="flexora-trainer-profile-card">

                <!-- Profile Top -->
                <div class="flexora-profile-top">

                    <!-- Trainer Icon -->
                    <div class="flexora-profile-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>


                    <div class="flexora-profile-heading">

                        <h2>
                            <%= trainer.tname %>
                        </h2>

                        <span class="flexora-profile-role">
                            <i class="bi bi-person-badge"></i>
                            Gym Trainer
                        </span>

                    </div>

                </div>


                <!-- Trainer Information -->
                <div class="flexora-profile-section">

                    <h3>
                        <i class="bi bi-person-vcard"></i>
                        Personal Information
                    </h3>


                    <div class="flexora-profile-grid">

                        <!-- Name -->
                        <div class="flexora-profile-item">

                            <span class="profile-label">
                                Full Name
                            </span>

                            <strong>
                                <%= trainer.tname %>
                            </strong>

                        </div>


                        <!-- Email -->
                        <div class="flexora-profile-item">

                            <span class="profile-label">
                                Email Address
                            </span>

                            <strong>
                                <%= trainer.email %>
                            </strong>

                        </div>


                        <!-- Age -->
                        <div class="flexora-profile-item">

                            <span class="profile-label">
                                Age
                            </span>

                            <strong>
                                <%= trainer.age %> years
                            </strong>

                        </div>


                        <!-- Experience -->
                        <div class="flexora-profile-item">

                            <span class="profile-label">
                                Experience
                            </span>

                            <strong>
                                <%= trainer.experience %> years
                            </strong>

                        </div>

                        <!-- Assigned Members -->
                        <div class="flexora-profile-section flexora-assigned-members-section">

                            <div class="flexora-section-heading">
                                <div>
                                    <h3>
                                        <i class="bi bi-people"></i>
                                        Assigned Members
                                    </h3>
                                    <p>
                                        Members currently assigned to this trainer.
                                    </p>
                                </div>

                                <span class="flexora-member-count">
                                    <i class="bi bi-people-fill"></i>
                                    <%= members.length %> Members
                                </span>
                            </div>


                            <% if (members.length===0) { %>

                                <!-- No Members -->
                                <div class="flexora-no-members">
                                    <div class="flexora-no-members-icon">
                                        <i class="bi bi-person-x"></i>
                                    </div>

                                    <h4>No Members Assigned</h4>

                                    <p>
                                        This trainer currently has no members assigned.
                                    </p>
                                </div>

                                <% } else { %>

                                    <!-- Members List -->
                                    <div class="flexora-members-grid">

                                        <% members.forEach(member=> { %>

                                            <div class="flexora-assigned-member-card">

                                                <!-- Member Icon -->
                                                <div class="flexora-member-icon">
                                                    <i class="bi bi-person"></i>
                                                </div>


                                                <!-- Member Info -->
                                                <div class="flexora-assigned-member-info">

                                                    <h4>
                                                        <%= member.mname %>
                                                    </h4>

                                                    <p>
                                                        <i class="bi bi-envelope"></i>
                                                        <%= member.email %>
                                                    </p>

                                                    <div class="flexora-member-meta">

                                                        <span>
                                                            <i class="bi bi-person"></i>
                                                            <%= member.age %> years
                                                        </span>

                                                        <span>
                                                            <i class="bi bi-dumbbell"></i>
                                                            <%= member.workoutPlan || "No plan" %>
                                                        </span>

                                                    </div>

                                                </div>


                                                <!-- View Member -->
                                                <a href="/flexora/member/<%= member._id %>"
                                                    class="flexora-view-member-btn">
                                                    <i class="bi bi-arrow-right"></i>
                                                </a>

                                            </div>

                                            <% }) %>

                                    </div>

                                    <% } %>

                        </div>


                    </div>

                </div>


                <!-- Actions -->
                <div class="flexora-profile-actions">

                    <a href="/flexora/trainer/<%= trainer._id %>/edit" class="flexora-edit-btn">
                        <i class="bi bi-pencil-square"></i>
                        Edit Trainer
                    </a>


                    <form action="/flexora/trainer/<%= trainer._id %>?_method=DELETE" method="post">

                        <button type="submit" class="flexora-delete-btn">
                            <i class="bi bi-trash3"></i>
                            Delete Trainer
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </section>