<% layout("./layouts/boilerplate.ejs") %>

    <!-- ================= EDIT TRAINER PAGE ================= -->

    <section class="flexora-trainer-form-page">

        <div class="container-fluid px-3 px-lg-5">

            <!-- Page Header -->

            <div class="flexora-page-header">

                <div>

                    <div class="flexora-breadcrumb">

                        <a href="/flexora">Home</a>
                        <span>/</span>

                        <a href="/flexora/trainer">Trainers</a>
                        <span>/</span>

                        <span>Edit Trainer</span>

                    </div>

                    <h1>Edit Trainer</h1>

                    <p>
                        Update the trainer's information.
                    </p>

                </div>

            </div>


            <!-- Form Card -->

            <div class="flexora-trainer-form-card">

                <!-- Card Header -->

                <div class="flexora-form-card-header">

                    <div class="flexora-form-icon">

                        <i class="bi bi-person-plus-fill"></i>

                    </div>

                    <div>

                        <h2>Trainer Details</h2>

                        <p>
                            Update the trainer's information below.
                        </p>

                    </div>

                </div>


                <!-- Form -->

                <form action="/flexora/trainer/<%= trainer._id %>?_method=PUT" method="post">

                    <div class="flexora-trainer-form-grid">


                        <!-- Trainer Name -->

                        <div class="flexora-form-field">

                            <label for="tname">
                                Trainer Name
                            </label>

                            <div class="flexora-input-wrapper">

                                <i class="bi bi-person"></i>

                                <input type="text" id="tname" name="tname" value="<%= trainer.tname %>"
                                    placeholder="Enter trainer name" required>

                            </div>

                        </div>


                        <!-- Email -->

                        <div class="flexora-form-field">

                            <label for="email">
                                Email
                            </label>

                            <div class="flexora-input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <input type="email" id="email" name="email" value="<%= trainer.email %>"
                                    placeholder="Enter email address" required>

                            </div>

                        </div>


                        <!-- Age -->

                        <div class="flexora-form-field">

                            <label for="age">
                                Age
                            </label>

                            <div class="flexora-input-wrapper">

                                <i class="bi bi-calendar3"></i>

                                <input type="number" id="age" name="age" value="<%= trainer.age %>"
                                    placeholder="Enter age" min="16" required>

                            </div>

                        </div>


                        <!-- Experience -->

                        <div class="flexora-form-field">

                            <label for="experience">
                                Experience
                            </label>

                            <div class="flexora-input-wrapper">

                                <i class="bi bi-award"></i>

                                <input type="number" id="experience" name="experience" value="<%= trainer.experience %>"
                                    placeholder="Years of experience" min="0" required>

                            </div>

                        </div>

                    </div>


                    <!-- Actions -->

                    <div class="flexora-form-actions">

                        <button type="button" class="flexora-cancel-btn" onclick="history.back()">
                            Cancel
                        </button>


                        <button type="submit" class="flexora-submit-btn">

                            <i class="bi bi-pencil-square"></i>

                            Update Trainer

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </section>