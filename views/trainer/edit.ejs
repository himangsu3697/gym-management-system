<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/flexora/trainer/<%=trainer._id%>?_method=PUT" method="post">
        <input type="text" name="tname" value="<%=trainer.tname%>">Trainer Name <br>
        <input type="text" name="email" value="<%=trainer.email%>">Email <br>
        <input type="number" name="age" value="<%=trainer.age%>">Age <br>
        <input type="number" name="experience" value="<%=trainer.experience%>">Experience <br>
        <button>Submit</button>
    </form>
</body>
</html>