<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <p>mname : <%=member.mname%></p>
        <p>email : <%=member.email%></p>
        <p>age : <%=member.age%></p>
        <p>workout plan : <%=member.workoutPlan%></p>
        <p>trainer : <%=member.trainer%></p>
        <p>membership : <%=member.membership%></p>
        <p>start date : <%=member.membershipStartDate%></p>
        <p>end date : <%=member.membershipEndDate%></p>
        <button><a href="/flexora/member/<%=member._id%>/edit">Edit</a></button>
        <form action="/flexora/member/<%=member._id%>?_method=DELETE" method="post">
            <button>Delete</button>
        </form>
        <button><a href="/flexora/member/<%=member._id%>/membership">Add membership</a></button> <br>
        <button><a href="/flexora/member/<%=member._id%>/membership/change">change membership</a></button> <br>
        <form action="/flexora/member/<%=member._id%>/membership?_method=DELETE" method="post">
            <button>Delete membership</button>
        </form>
        <button><a href="/flexora/member/<%=member._id%>/trainer">Add trainer</a></button> <br>
        <button><a href="/flexora/member/<%=member._id%>/trainer/change">change trainer</a></button>
        <form action="/flexora/member/<%=member._id%>/trainer?_method=DELETE" method="post">
            <button>Delete trainer</button>
        </form>
    </div>
</body>
</html>