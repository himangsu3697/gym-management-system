<% layout("./layouts/boilerplate.ejs") %>

    <div class="flexora-trainer-select-page">

        <!-- Page Header -->
        <div class="flexora-page-header">
            <div>

                <div class="flexora-breadcrumb">
                    <span>Home</span>
                    <i class="fa-solid fa-chevron-right"></i>
                    <span>Members</span>
                    <i class="fa-solid fa-chevron-right"></i>
                    <span>Change Trainer</span>
                </div>

                <h1>Change Trainer</h1>

                <p>
                    Choose a new personal trainer for this member.
                </p>

            </div>
        </div>


        <!-- Change Trainer Card -->
        <div class="flexora-trainer-select-card">

            <div class="flexora-form-header">

                <div class="flexora-form-icon">
                    <i class="fa-solid fa-user-pen"></i>
                </div>

                <div>
                    <h2>Change Personal Trainer</h2>
                    <p>Select a different trainer from the available trainers.</p>
                </div>

            </div>


            <form action="/flexora/member/<%=id%>/trainer?_method=PUT" method="post">

                <div class="flexora-form-group">

                    <label for="trainerId">
                        <i class="fa-solid fa-dumbbell"></i>
                        New Trainer
                    </label>

                    <div class="select-wrapper">

                        <select name="trainerId" id="trainerId" required>

                            <option value="" disabled selected>
                                Select a trainer
                            </option>

                            <% for(let trainer of trainers) { %>

                                <option value="<%=trainer._id%>">
                                    <%=trainer.tname%> —
                                        <%=trainer.experience%> years experience
                                </option>

                                <% } %>

                        </select>

                    </div>

                </div>


                <div class="flexora-form-actions">

                    <a href="/flexora/member/<%=id%>" class="flexora-cancel-btn">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back
                    </a>

                    <button type="submit" class="flexora-submit-btn">
                        <i class="fa-solid fa-user-pen"></i>
                        Change Trainer
                    </button>

                </div>

            </form>

        </div>

    </div>