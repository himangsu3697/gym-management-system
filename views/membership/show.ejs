<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <p>plan name : <%= membership.planName %></p>
        <p>duration in Months : <%= membership.durationInMonths %></p>
