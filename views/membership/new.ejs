<% layout("./layouts/boilerplate.ejs") %>

    <div class="membership-page offset-custom">

        <div class="page-header">
            <div>
                <h1>Create Membership</h1>
                <p>Home / Memberships / Create Membership</p>
            </div>
        </div>


        <div class="membership-card">

            <div class="card-header">
                <div class="card-icon">
                    +
                </div>

                <div>
                    <h2>Membership Details</h2>
                    <p>Create a new membership plan for your gym</p>
                </div>
            </div>


            <form action="/flexora/membership" method="post">

                <div class="membership-form-grid">

                    <!-- Plan Name -->

                    <div class="form-field plan-field">
                        <label class="plan-section-label">
                            Membership Plan
                        </label>

                        <div class="plan-options">

                            <div class="plan-option">
                                <input type="radio" id="basic" name="planName" value="Basic" required>

                                <label for="basic" class="plan-card">
                                    <div class="plan-card-icon">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div class="plan-card-content">
                                        <h3>Basic</h3>
                                        <p>Essential gym access</p>
                                    </div>

                                    <div class="plan-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </label>
                            </div>


                            <div class="plan-option">
                                <input type="radio" id="premium" name="planName" value="Premium">

                                <label for="premium" class="plan-card">
                                    <div class="plan-card-icon">
                                        <i class="bi bi-lightning-charge"></i>
                                    </div>

                                    <div class="plan-card-content">
                                        <h3>Premium</h3>
                                        <p>More features & benefits</p>
                                    </div>

                                    <div class="plan-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </label>
                            </div>


                            <div class="plan-option">
                                <input type="radio" id="elite" name="planName" value="Elite">

                                <label for="elite" class="plan-card">
                                    <div class="plan-card-icon">
                                        <i class="bi bi-gem"></i>
                                    </div>

                                    <div class="plan-card-content">
                                        <h3>Elite</h3>
                                        <p>Premium fitness experience</p>
                                    </div>

                                    <div class="plan-check">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </label>
                            </div>

                        </div>

                    </div>


                    <!-- Duration -->
                    <div class="form-field">

                        <label for="duration">Duration</label>

                        <select id="duration" name="durationInMonths" required>

                            <option value="" disabled selected>
                                Select duration
                            </option>

                            <option value="1">
                                1 Month
                            </option>

                            <option value="3">
                                3 Months
                            </option>

                            <option value="6">
                                6 Months
                            </option>

                            <option value="12">
                                12 Months
                            </option>

                        </select>

                    </div>


                    <!-- Price -->
                    <div class="form-field">

                        <label for="price">
                            Price (₹)
                        </label>

                        <input type="number" id="price" name="price" placeholder="e.g. 4000" min="1" step="1" required>

                    </div>


                    <!-- Status -->
                    <div class="form-field">

                        <label for="status">
                            Status
                        </label>

                        <select id="status" name="status" required>

                            <option value="active">
                                Active
                            </option>

                            <option value="inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>


                <!-- Facilities -->
                <div class="facilities-container">

                    <label class="section-label">
                        Facilities Included
                    </label>

                    <div class="facilities-grid">

                        <div class="facility">

                            <input type="checkbox" id="gymAccess" name="facilities" value="Gym Access" required>

                            <label for="gymAccess">
                                Gym Access
                            </label>

                        </div>


                        <div class="facility">

                            <input type="checkbox" id="locker" name="facilities" value="Locker" required>

                            <label for="locker">
                                Locker
                            </label>

                        </div>


                        <div class="facility">

                            <input type="checkbox" id="cardio" name="facilities" value="Cardio Area">

                            <label for="cardio">
                                Cardio Area
                            </label>

                        </div>


                        <div class="facility">

                            <input type="checkbox" id="classes" name="facilities" value="Group Classes">

                            <label for="classes">
                                Group Classes
                            </label>

                        </div>


                        <div class="facility">

                            <input type="checkbox" id="trainer" name="facilities" value="Personal Trainer">

                            <label for="trainer">
                                Personal Trainer
                            </label>

                        </div>


                        <div class="facility">

                            <input type="checkbox" id="diet" name="facilities" value="Diet Consultation">

                            <label for="diet">
                                Diet Consultation
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Description -->
                <div class="form-field description-field">

                    <label for="description">
                        Description
                    </label>

                    <textarea id="description" name="description" placeholder="Enter membership description..."
                        minlength="10" maxlength="500" required></textarea>

                </div>


                <!-- Buttons -->
                <div class="form-actions">

                    <button type="button" class="cancel-btn" onclick="history.back()">
                        Cancel
                    </button>

                    <button type="submit" class="submit-btn">
                        Create Membership
                    </button>

                </div>

            </form>

        </div>

    </div>