<% layout("./layouts/boilerplate.ejs") %>

    <div class="flexora-about-page">

        <!-- ==================== HERO ==================== -->
        <section class="about-hero">

            <!-- Decorative Elements -->
            <div class="about-glow about-glow-one"></div>
            <div class="about-glow about-glow-two"></div>

            <div class="about-hero-content">

                <div class="about-label">
                    <span class="label-dot"></span>
                    ABOUT FLEXORA
                </div>

                <h1>
                    Smarter Gym
                    <span>Management.</span>
                </h1>

                <p>
                    Flexora is a centralized gym management system designed
                    to simplify the everyday management of members,
                    memberships, trainers, and workout information.
                </p>

                <div class="about-hero-stats">

                    <div class="about-stat">
                        <div class="stat-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <div>
                            <strong>Members</strong>
                            <span>Management</span>
                        </div>
                    </div>

                    <div class="stat-divider"></div>

                    <div class="about-stat">
                        <div class="stat-icon">
                            <i class="fa-solid fa-id-card"></i>
                        </div>

                        <div>
                            <strong>Memberships</strong>
                            <span>Tracking</span>
                        </div>
                    </div>

                    <div class="stat-divider"></div>

                    <div class="about-stat">
                        <div class="stat-icon">
                            <i class="fa-solid fa-dumbbell"></i>
                        </div>

                        <div>
                            <strong>Trainers</strong>
                            <span>Management</span>
                        </div>
                    </div>

                </div>

            </div>


            <!-- Hero Visual -->
            <div class="about-hero-visual">

                <div class="hero-ring hero-ring-one"></div>
                <div class="hero-ring hero-ring-two"></div>

                <div class="hero-dumbbell">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <div class="floating-card floating-card-one">
                    <i class="fa-solid fa-user-check"></i>

                    <div>
                        <strong>Members</strong>
                        <span>Organized</span>
                    </div>
                </div>

                <div class="floating-card floating-card-two">
                    <i class="fa-solid fa-calendar-check"></i>

                    <div>
                        <strong>Membership</strong>
                        <span>Tracked</span>
                    </div>
                </div>

                <div class="floating-card floating-card-three">
                    <i class="fa-solid fa-person-chalkboard"></i>

                    <div>
                        <strong>Trainer</strong>
                        <span>Assigned</span>
                    </div>
                </div>

            </div>

        </section>


        <!-- ==================== INTRODUCTION ==================== -->
        <section class="about-intro">

            <div class="about-intro-heading">

                <span class="about-section-label">
                    <i class="fa-solid fa-circle-info"></i>
                    WHAT IS FLEXORA?
                </span>

                <h2>
                    Everything You Need to
                    <span>Organize Your Gym</span>
                </h2>

            </div>

            <div class="about-intro-text">

                <p>
                    Managing a gym involves more than just keeping track of
                    members. Membership plans, trainers, workout plans,
                    membership durations, and member information all need
                    to stay organized.
                </p>

                <p>
                    Flexora brings these essential operations together in
                    one structured system, making gym management easier,
                    more organized, and less dependent on manual records.
                </p>

            </div>

        </section>


        <!-- ==================== FEATURES ==================== -->
        <section class="about-features">

            <div class="about-section-heading">

                <span class="about-section-label">
                    <i class="fa-solid fa-layer-group"></i>
                    FLEXORA FEATURES
                </span>

                <h2>
                    Built Around Your
                    <span>Gym Operations</span>
                </h2>

                <p>
                    Flexora provides dedicated features for managing the
                    important parts of a gym from a single system.
                </p>

            </div>


            <div class="features-grid">

                <!-- Member -->
                <div class="feature-card feature-card-large">

                    <div class="feature-number">
                        01
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h3>Member Management</h3>

                    <p>
                        Maintain complete member information including name,
                        email, age, workout plan, membership details and
                        assigned trainer.
                    </p>

                    <div class="feature-tags">
                        <span>Member Records</span>
                        <span>Profile Details</span>
                        <span>Workout Plan</span>
                    </div>

                </div>


                <!-- Membership -->
                <div class="feature-card feature-card-large">

                    <div class="feature-number">
                        02
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>

                    <h3>Membership Management</h3>

                    <p>
                        Create and manage predefined membership plans with
                        different durations, prices and available facilities.
                    </p>

                    <div class="feature-tags">
                        <span>Plans</span>
                        <span>Duration</span>
                        <span>Facilities</span>
                    </div>

                </div>


                <!-- Trainer -->
                <div class="feature-card">

                    <div class="feature-number">
                        03
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-person-chalkboard"></i>
                    </div>

                    <h3>Trainer Management</h3>

                    <p>
                        Store trainer information and manage trainer
                        assignments for eligible gym members.
                    </p>

                    <div class="feature-tags">
                        <span>Trainer Records</span>
                        <span>Assignment</span>
                    </div>

                </div>


                <!-- Membership Tracking -->
                <div class="feature-card">

                    <div class="feature-number">
                        04
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <h3>Membership Tracking</h3>

                    <p>
                        Keep track of membership start dates, end dates
                        and current membership status.
                    </p>

                    <div class="feature-tags">
                        <span>Start Date</span>
                        <span>End Date</span>
                        <span>Status</span>
                    </div>

                </div>


                <!-- Workout -->
                <div class="feature-card">

                    <div class="feature-number">
                        05
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>

                    <h3>Workout Plan Management</h3>

                    <p>
                        Keep workout plan information connected with
                        individual gym members.
                    </p>

                    <div class="feature-tags">
                        <span>Workout Plans</span>
                        <span>Member Based</span>
                    </div>

                </div>


                <!-- Data -->
                <div class="feature-card">

                    <div class="feature-number">
                        06
                    </div>

                    <div class="feature-icon">
                        <i class="fa-solid fa-database"></i>
                    </div>

                    <h3>Centralized Data</h3>

                    <p>
                        Keep member, trainer and membership information
                        organized through a centralized database.
                    </p>

                    <div class="feature-tags">
                        <span>MongoDB</span>
                        <span>Structured Data</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== HOW IT CONNECTS ==================== -->
        <section class="about-system">

            <div class="about-section-heading">

                <span class="about-section-label">
                    <i class="fa-solid fa-diagram-project"></i>
                    CONNECTED MANAGEMENT
                </span>

                <h2>
                    Everything Works
                    <span>Together</span>
                </h2>

                <p>
                    Flexora connects the major parts of gym management
                    so information can move naturally between members,
                    memberships and trainers.
                </p>

            </div>


            <div class="system-flow">

                <!-- Member -->
                <div class="system-box">

                    <div class="system-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <h3>Member</h3>

                    <p>
                        Personal information and
                        workout details
                    </p>

                </div>


                <div class="flow-line">
                    <i class="fa-solid fa-chevron-right"></i>
                </div>


                <!-- Membership -->
                <div class="system-box system-box-highlight">

                    <div class="system-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>

                    <h3>Membership</h3>

                    <p>
                        Plan, duration,
                        dates and status
                    </p>

                </div>


                <div class="flow-line">
                    <i class="fa-solid fa-chevron-right"></i>
                </div>


                <!-- Trainer -->
                <div class="system-box">

                    <div class="system-icon">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>

                    <h3>Trainer</h3>

                    <p>
                        Trainer information
                        and assignment
                    </p>

                </div>

            </div>

        </section>


        <!-- ==================== BENEFITS ==================== -->
        <section class="about-benefits">

            <div class="benefits-content">

                <span class="about-section-label">
                    <i class="fa-solid fa-bolt"></i>
                    WHY FLEXORA?
                </span>

                <h2>
                    Designed To Make
                    <span>Management Simpler</span>
                </h2>

                <p>
                    Flexora focuses on keeping gym management structured
                    and straightforward by bringing frequently used
                    operations into one system.
                </p>

            </div>


            <div class="benefits-list">

                <div class="benefit-item">

                    <div class="benefit-check">
                        <i class="fa-solid fa-check"></i>
                    </div>

                    <div>
                        <h3>Organized Information</h3>
                        <p>
                            Keep important gym records in one centralized
                            management system.
                        </p>
                    </div>

                </div>


                <div class="benefit-item">

                    <div class="benefit-check">
                        <i class="fa-solid fa-check"></i>
                    </div>

                    <div>
                        <h3>Easy Membership Management</h3>
                        <p>
                            Manage predefined plans and track membership
                            duration and status.
                        </p>
                    </div>

                </div>


                <div class="benefit-item">

                    <div class="benefit-check">
                        <i class="fa-solid fa-check"></i>
                    </div>

                    <div>
                        <h3>Connected Records</h3>
                        <p>
                            Connect members with their memberships and
                            assigned trainers.
                        </p>
                    </div>

                </div>


                <div class="benefit-item">

                    <div class="benefit-check">
                        <i class="fa-solid fa-check"></i>
                    </div>

                    <div>
                        <h3>Simple Administration</h3>
                        <p>
                            Perform common gym management operations
                            without relying on scattered records.
                        </p>
                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== BOTTOM STATEMENT ==================== -->
        <section class="about-bottom">

            <div class="bottom-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <h2>
                Flexora
                <span>Manage. Organize. Grow.</span>
            </h2>

            <p>
                A centralized solution for managing the essential
                operations of a modern gym.
            </p>

        </section>

    </div>